/*
 * CIDOO V75 Pro keymap for the own BLE stack (TLSR_BLE) and the 2.4G link
 * (TLSR_P24); the same as cidoo_v75pro.keymap but for the original firmware's BT channel keys
 * (Fn + Q/W/E): a tap selects ZMK profile 0/1/2, held 3 s it selects it and clears
 * its bond; and the original firmware's 2.4G key (Fn + R): held 3 s in the 2.4G position, it pairs.
 * Generated by gen_v75pro.py from the original keymap's layers 0 (Base) and 1 (Fn).
 * Original knob: left = &kp C_VOL_DN, right = &kp C_VOL_UP, press = 0,14.
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    macros {
        bt_sel: bt_sel {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&macro_param_1to2>, <&bt BT_SEL MACRO_PLACEHOLDER>;
        };
        bt_new: bt_new {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&macro_param_1to2>, <&bt BT_SEL MACRO_PLACEHOLDER>, <&bt BT_CLR>;
        };
    };

    behaviors {
        /* The original firmware's 2.4G pairing key, Fn + R held 3 s (the 2.4G position only) */
        p24_pair: p24_pair {
            compatible = "zmk,behavior-p24-pair";
            #binding-cells = <0>;
            hold-ms = <3000>;
        };
        bt_ch: bt_ch {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <3000>;
            bindings = <&bt_new>, <&bt_sel>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "Base";
            bindings = <
                &kp ESC         &kp F1          &kp F2          &kp F3          &kp F4          &kp F5          &kp F6          &kp F7          &kp F8          &kp F9          &kp F10         &kp F11         &kp F12         &kp DEL         &kp C_MUTE
                &kp GRAVE       &kp N1          &kp N2          &kp N3          &kp N4          &kp N5          &kp N6          &kp N7          &kp N8          &kp N9          &kp N0          &kp MINUS       &kp EQUAL       &kp BSPC        &kp HOME
                &kp TAB         &kp Q           &kp W           &kp E           &kp R           &kp T           &kp Y           &kp U           &kp I           &kp O           &kp P           &kp LBKT        &kp RBKT        &kp BSLH        &kp PG_UP
                &kp CAPS        &kp A           &kp S           &kp D           &kp F           &kp G           &kp H           &kp J           &kp K           &kp L           &kp SEMI        &kp SQT         &kp RET         &kp PG_DN
                &kp LSHFT       &kp Z           &kp X           &kp C           &kp V           &kp B           &kp N           &kp M           &kp COMMA       &kp DOT         &kp FSLH        &kp RSHFT       &kp UP
                &kp LCTRL       &kp LGUI        &kp LALT        &kp SPACE       &kp RALT        &mo 1           &kp RCTRL       &kp LEFT        &kp DOWN        &kp RIGHT
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        fn_layer {
            /* Original bindings left out (matrix row,col):
             *   1,11: RGB_SPD (no RGB yet)
             *   1,12: RGB_SPI (no RGB yet)
             *   1,13: RGB_TOG (no RGB yet)
             *   2,11: RGB_SAI (no RGB yet)
             *   2,12: RGB_SAD (no RGB yet)
             *   2,13: RGB_MOD (no RGB yet)
             *   2,14: LED LOGO MODE (original firmware only)
             *   3,1: WIN MODE (original firmware only)
             *   3,2: MAC MODE (original firmware only)
             *   3,14: LED LOGO COLOUR (original firmware only)
             *   4,6: BATT ST (original firmware only)
             *   4,13: RGB_VAI (no RGB yet)
             *   5,1: LOCK WIN KEY (original firmware only)
             *   5,12: RGB_HUD (no RGB yet)
             *   5,13: RGB_VAD (no RGB yet)
             *   5,14: RGB_HUI (no RGB yet)
             */
            display-name = "Fn";
            bindings = <
                &trans          &kp C_AL_CCC    &kp C_VOL_DN    &kp C_VOL_UP    &kp C_MUTE      &kp C_STOP      &kp C_PREV      &kp C_PP        &kp C_NEXT      &kp C_AL_EMAIL  &kp C_AC_HOME   &kp C_AL_CALC   &kp C_AC_SEARCH &kp INS         &trans
                &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &none           &none           &none           &kp END
                &trans          &bt_ch 0 0      &bt_ch 1 1      &bt_ch 2 2      &p24_pair       &trans          &trans          &trans          &trans          &trans          &trans          &none           &none           &none           &none
                &trans          &none           &none           &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &none
                &trans          &trans          &trans          &trans          &trans          &none           &trans          &trans          &trans          &trans          &trans          &trans          &none
                &trans          &none           &trans          &prev_fw        &trans          &trans          &trans          &none           &none           &none
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };
    };
};

/* Not on these keyboards: &sys_reset only reboots (settings stay), and &bootloader has no
 * bootloader to enter (firmware updates go through the update tool). */
&sys_reset {
	status = "disabled";
};

&bootloader {
	status = "disabled";
};
