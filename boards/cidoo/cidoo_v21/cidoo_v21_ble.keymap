/*
 * CIDOO V21 keymap for the own BLE stack (TLSR_BLE); the same as
 * cidoo_v21.keymap but for the original firmware's BLE channel keys (Fn + KP1/KP2/KP3):
 * a tap selects ZMK profile 0/1/2, held 3 s it selects it and clears its bond;
 * and the original firmware's 2.4G pairing key (Fn + KP4 held 3 s, &p24_pair).
 * Generated by gen_v21.py from the original keymap's layers 0 (Base) and 1 (Fn).
 * Original knob: left = &kp C_VOL_DN, right = &kp C_VOL_UP, press = 1,11.
 * Original keymap positions not in the VIA layout (no key on the board): 0,0 &kp ESC, 0,11 &kp BSPC, 1,9 &kp KP_COMMA.
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/bt.h>

/ {
    macros {
        bt_sel: bt_sel {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&macro_param_1to2>, <&bt BT_SEL MACRO_PLACEHOLDER>;
        };
        bt_new: bt_new {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&macro_param_1to2>, <&bt BT_SEL MACRO_PLACEHOLDER>, <&bt BT_CLR>;
        };
    };

    behaviors {
        /* The original firmware's 2.4G pairing key, Fn + KP4 held 3 s (the 2.4G position only) */
        p24_pair: p24_pair {
            compatible = "zmk,behavior-p24-pair";
            #binding-cells = <0>;
            hold-ms = <3000>;
        };
        bt_ch: bt_ch {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <3000>;
            bindings = <&bt_new>, <&bt_sel>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "Base";
            bindings = <
                &kp C_MUTE       &mo 1            &kp TAB          &kp BSPC
                &kp KP_NUMLOCK   &kp KP_DIVIDE    &kp KP_MULTIPLY  &kp KP_MINUS
                &kp KP_N7        &kp KP_N8        &kp KP_N9        &kp KP_PLUS
                &kp KP_N4        &kp KP_N5        &kp KP_N6
                &kp KP_N1        &kp KP_N2        &kp KP_N3        &kp KP_ENTER
                &kp KP_N0        &kp KP_DOT
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        fn_layer {
            display-name = "Fn";
            bindings = <
                &trans           &trans           &trans           &bl RGB_TOG
                &trans           &bl RGB_HUD      &bl RGB_HUI      &bl RGB_BRD
                &bl RGB_SPD      &bl RGB_SPI      &trans           &bl RGB_BRI
                &p24_pair        &bl RGB_SAI      &bl RGB_SAD
                &bt_ch 0 0       &bt_ch 1 1       &bt_ch 2 2       &bl RGB_EFF
                &prev_fw         &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };
    };
};

/* Not on these keyboards: &sys_reset only reboots (settings stay), and &bootloader has no
 * bootloader to enter (firmware updates go through the update tool). */
&sys_reset {
	status = "disabled";
};

&bootloader {
	status = "disabled";
};
