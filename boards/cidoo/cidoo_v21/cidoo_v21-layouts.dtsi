#include <dt-bindings/zmk/matrix_transform.h>
#include <physical_layouts.dtsi>

/ {
    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        rows = <2>;
        columns = <12>;
        map = <
            RC(1,11) RC(0,1) RC(0,2) RC(0,3)
            RC(1,0) RC(1,1) RC(1,2) RC(1,3)
            RC(0,4) RC(0,5) RC(0,6) RC(0,7)
            RC(1,4) RC(1,5) RC(1,6)
            RC(0,8) RC(0,9) RC(0,10) RC(1,10)
            RC(1,7) RC(1,8)
        >;
    };

    v21_layout: v21_layout {
        compatible = "zmk,physical-layout";
        display-name = "Numpad";
        transform = <&default_transform>;
        keys  //                     w   h    x    y  rot  rx  ry
            = <&key_physical_attrs 100 100   10    0    0   0   0>  // 1,11
            , <&key_physical_attrs 100 100  120    0    0   0   0>  // 0,1
            , <&key_physical_attrs 100 100  230    0    0   0   0>  // 0,2
            , <&key_physical_attrs 100 100  340    0    0   0   0>  // 0,3
            , <&key_physical_attrs 100 100   10  100    0   0   0>  // 1,0
            , <&key_physical_attrs 100 100  120  100    0   0   0>  // 1,1
            , <&key_physical_attrs 100 100  230  100    0   0   0>  // 1,2
            , <&key_physical_attrs 100 100  340  100    0   0   0>  // 1,3
            , <&key_physical_attrs 100 100   10  200    0   0   0>  // 0,4
            , <&key_physical_attrs 100 100  120  200    0   0   0>  // 0,5
            , <&key_physical_attrs 100 100  230  200    0   0   0>  // 0,6
            , <&key_physical_attrs 100 200  340  200    0   0   0>  // 0,7
            , <&key_physical_attrs 100 100   10  300    0   0   0>  // 1,4
            , <&key_physical_attrs 100 100  120  300    0   0   0>  // 1,5
            , <&key_physical_attrs 100 100  230  300    0   0   0>  // 1,6
            , <&key_physical_attrs 100 100   10  400    0   0   0>  // 0,8
            , <&key_physical_attrs 100 100  120  400    0   0   0>  // 0,9
            , <&key_physical_attrs 100 100  230  400    0   0   0>  // 0,10
            , <&key_physical_attrs 100 200  340  400    0   0   0>  // 1,10
            , <&key_physical_attrs 210 100   10  500    0   0   0>  // 1,7
            , <&key_physical_attrs 100 100  230  500    0   0   0>  // 1,8
            ;
    };
};
