/*
 * CIDOO V21 default keymap.
 * Generated by gen_v21.py from the original keymap's layers 0 (Base) and 1 (Fn).
 * Original knob: left = &kp C_VOL_DN, right = &kp C_VOL_UP, press = 1,11.
 * Original keymap positions not in the VIA layout (no key on the board): 0,0 &kp ESC, 0,11 &kp BSPC, 1,9 &kp KP_COMMA.
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "Base";
            bindings = <
                &kp C_MUTE       &mo 1            &kp TAB          &kp BSPC
                &kp KP_NUMLOCK   &kp KP_DIVIDE    &kp KP_MULTIPLY  &kp KP_MINUS
                &kp KP_N7        &kp KP_N8        &kp KP_N9        &kp KP_PLUS
                &kp KP_N4        &kp KP_N5        &kp KP_N6
                &kp KP_N1        &kp KP_N2        &kp KP_N3        &kp KP_ENTER
                &kp KP_N0        &kp KP_DOT
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        fn_layer {
            /* Original bindings left out (matrix row,col):
             *   1,4: 2.4G pairing (original firmware only)
             *   0,8: BT channel 1 (original firmware only)
             *   0,9: BT channel 2 (original firmware only)
             *   0,10: BT channel 3 (original firmware only)
             */
            display-name = "Fn";
            bindings = <
                &trans           &trans           &trans           &bl RGB_TOG
                &trans           &bl RGB_HUD      &bl RGB_HUI      &bl RGB_BRD
                &bl RGB_SPD      &bl RGB_SPI      &trans           &bl RGB_BRI
                &none            &bl RGB_SAI      &bl RGB_SAD
                &none            &none            &none            &bl RGB_EFF
                &prev_fw         &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };
    };
};

/* Not on these keyboards: &sys_reset only reboots (settings stay), and &bootloader has no
 * bootloader to enter (firmware updates go through the update tool). */
&sys_reset {
	status = "disabled";
};

&bootloader {
	status = "disabled";
};
